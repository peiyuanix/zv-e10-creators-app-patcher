# Original Sony packages and generated Android binaries
*.apk
*.apkm
*.xapk
*.apks
*.aab
*.idsig
*.aligned
*:Zone.Identifier
inputs/
out/
build/

# Downloaded tools / SDKs (keep these local)
*.jar
android-sdk/

# Signing material: retain locally for updates, never publish
*.jks
*.keystore
*.pass
*.pem
*.key

# Logs can include camera / device identifiers
logs/
*.log

# Python and editor caches
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.DS_Store
.vscode/
.idea/

# Local agent / account state
.claude/
.codex/
.agents/
.aws/
